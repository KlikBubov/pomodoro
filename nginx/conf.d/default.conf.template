# HTTP -> HTTPS Redirect & Let's Encrypt Challenge
server {
    listen 80;
    server_name ${DOMAIN} umami.${DOMAIN} grafana.${DOMAIN} glitchtip.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main Domain (Pomodoro App)
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Serve static files directly via Nginx
    location /static/ {
        alias /app/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Service Worker should not be cached aggressively
    location = /static/js/sw.js {
        alias /app/static/js/sw.js;
        add_header Service-Worker-Allowed /;
        expires 0;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        access_log off;
    }

    # Proxy API and pages to Gunicorn
    location / {
        proxy_pass http://pomodoro:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

