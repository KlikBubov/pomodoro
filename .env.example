# ==========================================
# Pomodoro Stack Environment Configuration
# ==========================================

# --- General ---
# Domain name for Nginx (use 'localhost' for local development)
DOMAIN=localhost

# --- Flask Application ---
FLASK_DEBUG=false
# GlitchTip DSN (Leave empty initially, fill after GlitchTip setup)
SENTRY_DSN=

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana

# --- Umami (Analytics) ---
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=change_me_umami_db_pass
UMAMI_DB_NAME=umami
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
UMAMI_DATABASE_URL=postgresql://umami:change_me_umami_db_pass@umami-db:5432/umami
UMAMI_APP_SECRET=generate_random_string_1

# --- GlitchTip (Error Tracking) ---
GLITCHTIP_SECRET_KEY=generate_random_string_2
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASSWORD=change_me_glitchtip_db_pass
GLITCHTIP_DB_NAME=glitchtip
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
GLITCHTIP_DATABASE_URL=postgres://glitchtip:change_me_glitchtip_db_pass@glitchtip-db:5432/glitchtip
GLITCHTIP_REDIS_URL=redis://glitchtip-redis:6379/0
# Use smtp://localhost:25 to disable email sending locally
EMAIL_URL=smtp://localhost:25